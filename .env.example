# Public address of the site (no trailing slash)
PUBLIC_SITE_URL=https://example.com

# Company name shown in the header, footer and page titles
PUBLIC_COMPANY_NAME_EN=AIMS
PUBLIC_COMPANY_NAME_FA=آیمز

# Contact channels. Leave blank any channel you do not use.
PUBLIC_CONTACT_EMAIL=
PUBLIC_CONTACT_PHONE=
PUBLIC_CONTACT_WHATSAPP=
PUBLIC_CONTACT_TELEGRAM=

# Optional: URL that receives the contact form as JSON (POST).
# If empty, the form opens the visitor's email app addressed to PUBLIC_CONTACT_EMAIL.
PUBLIC_CONTACT_FORM_ENDPOINT=
